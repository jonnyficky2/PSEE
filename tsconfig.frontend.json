{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "frontend/dist",
    "rootDir": "frontend/src",
    "skipLibCheck": true
  },
  "include": ["frontend/src/**/*.ts"]
}
